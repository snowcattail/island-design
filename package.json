{
    "name": "island-design-workspace",
    "version": "1.0.0",
    "description": "A nature-inspired React component library",
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev --workspace=@island-design/demo",
        "gen": "node scripts/create-component.mjs",
        "build": "npm run build --workspace=@island-design/tokens && npm run build --workspace=@island-design/hooks && npm run build --workspace=island-design",
        "build:demo": "npm run build --workspace=@island-design/demo",
        "deploy": "npm run build:demo && gh-pages -d apps/demo/demo-dist",
        "test": "npm run test --workspace=island-design",
        "test:run": "npm run test:run --workspace=island-design && npm run test:a11y --workspace=island-design",
        "test:cov": "npm run test:cov --workspace=island-design",
        "test:a11y": "npm run test:a11y --workspace=island-design",
        "badges": "node scripts/generate-coverage-badges.mjs",
        "check:docs": "node scripts/check-docs-sync.mjs",
        "check:bundle": "node scripts/check-bundle.mjs",
        "check:types": "npm run check:types --workspace=island-design && npm run check:types --workspace=@island-design/demo && node scripts/check-dts-esm.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "ci": "npm run format:check && npm run check:docs && npm run lint && npm run typecheck && npm run test:run && npm run build && npm run check:bundle && npm run check:types",
        "setup:hooks": "git config core.hooksPath .githooks",
        "prepare": "npm run setup:hooks"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@fontsource/noto-sans-sc": "^5.2.9",
        "@fontsource/nunito": "^5.2.7",
        "@laynezh/vite-plugin-lib-assets": "^2.1.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.5.2",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^4.1.11",
        "axe-core": "^4.12.1",
        "eslint": "^9.0.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.12",
        "gh-pages": "^6.3.0",
        "globals": "^15.0.0",
        "jsdom": "^29.1.1",
        "less": "^4.2.1",
        "modern-screenshot": "^4.6.0",
        "prettier": "^3.4.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.0.0",
        "vite": "^7.3.2",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^4.1.11",
        "vitest-axe": "^0.1.0"
    },
    "private": true
}
